# Caddy mengurus HTTPS (Let's Encrypt) dan WebSocket secara otomatis.

# Pilihan A: subdomain sendiri
suit.domainmu.com {
    reverse_proxy 127.0.0.1:8080
}

# Pilihan B: sub-path di domain yang sudah ada (tempel di dalam blok domainmu)
