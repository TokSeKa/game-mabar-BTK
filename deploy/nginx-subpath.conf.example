# Suit Bot Arena di sub-path domain yang sudah ada, misalnya https://domainmu.com/suitbot/
# Tempel blok location di bawah ke dalam blok server { ... } milik proyekmu yang sudah ada.
# Blok map taruh di luar server { } (level http), cukup sekali.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# --- tempel di dalam server { ... } ---
location = /suitbot {
    return 301 /suitbot/;
}

location /suitbot/ {
    # garis miring di akhir proxy_pass PENTING: membuang awalan /suitbot/ sebelum diteruskan
    proxy_pass http://127.0.0.1:8080/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
}
