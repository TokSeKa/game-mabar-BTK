# Suit Bot Arena di subdomain sendiri, misalnya https://suit.domainmu.com
# Salin ke /etc/nginx/sites-available/suitbot lalu aktifkan (lihat DEPLOY.md).
# Ganti suit.domainmu.com dan port 8080 sesuai .env kamu.

# Dibutuhkan untuk WebSocket. Kalau blok map yang sama sudah ada di config lain, hapus blok ini.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name suit.domainmu.com;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # koneksi room bisa terbuka lama
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
