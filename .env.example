# Salin jadi .env lalu sesuaikan.

# Port di VPS (host). Container selalu mendengarkan di 8000.
# Default hanya bisa diakses dari VPS sendiri (127.0.0.1) supaya lewat reverse proxy.
PORT=8080
BIND_ADDRESS=127.0.0.1

# Jumlah proses untuk menghitung match secara paralel (1-4 cukup untuk main bareng).
MATCH_WORKERS=2

# Batas langkah per bot per ronde. Makin besar = bot boleh makin "mikir", server makin berat.
BOT_MAX_STEPS=20000

# Jumlah room maksimal sekaligus.
MAX_ROOMS=200

# Pemain offline dihapus dari room setelah sekian detik (default 10 menit).
PLAYER_GRACE_SECONDS=600

# Room tanpa pemain online dihapus setelah sekian detik (default 30 menit).
ROOM_IDLE_SECONDS=1800

# Jumlah latihan (arena latihan) yang boleh berjalan bersamaan.
PRACTICE_CONCURRENCY=4

# Batas sumber daya container. Pengunduh data kripto penuh butuh ±1,5 GB RAM saat memproses BTC/ETH.
MEM_LIMIT=2g
CPUS=1.0

# Lokasi data Kilas Pasar (candle + akun). Default: volume Docker bernama "pasar-data".
# Bisa diganti folder, misalnya PASAR_DATA=./data  (di Linux: sudo chown -R 10001:10001 ./data)
PASAR_DATA=pasar-data

# Backtest (tab Backtest di Kilas Pasar). 0 = matikan (misalnya di server publik).
BACKTEST_AKTIF=1
# Batas waktu satu backtest (detik).
BACKTEST_TIMEOUT=900
# Folder data pengumpul-data (repo anything). Default: ../anything/pengumpul-data/data
# PENGUMPUL_DATA=../anything/pengumpul-data/data
